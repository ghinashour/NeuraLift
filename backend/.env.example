# ---- Required ----
PORT=4000
MONGO_URI=mongodb://localhost:27017/neuralift
JWT_SECRET=replace-me-32-chars-min
JWT_REFRESH_SECRET=replace-me-32-chars-min
# Comma-separated origins, e.g. https://app.onrender.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# ---- AI ----
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
# Groq (primary for POST /api/chat) — get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed for legacy fallback (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=neuralift-docs

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google console redirect, e.g. https://api.example.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Mail (pick one provider scheme, see utils/) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Legacy aliases used by some utils
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@neuralift.app
CONTACT_EMAIL=support@neuralift.app
CLIENT_URL=http://localhost:3000
