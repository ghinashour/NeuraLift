# ---- Required ----
PORT=4000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/neuralift?retryWrites=true&w=majority
JWT_SECRET=replace-me-32-chars-min
JWT_REFRESH_SECRET=replace-me-32-chars-min
# Comma-separated origins, e.g. https://app.onrender.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# ---- AI ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Groq (primary for POST /api/chat) — get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed for legacy fallback (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=neuralift-docs

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google console redirect, e.g. https://api.example.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Resend HTTPS email (required for signup verification and contact mail) ----
# Set these in Render. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4000
