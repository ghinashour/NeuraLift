# dependencies — never commit these (Render/Vercel run npm install)
node_modules/
backend/node_modules/
frontend/node_modules/

# builds
frontend/build/
backend/logs/

# uploads are runtime data (Render disk is ephemeral)
backend/uploads/*

# env secrets
.env
backend/.env
frontend/.env
*.local

# OS / editor
.DS_Store
.vscode/
.idea/

# local file history (VS Code extension) — snapshots may contain secrets
.history/
